+[[nodiscard]] float64 SpringTransition(float64 delta, float64 dt) {
+	if (dt <= 0.) {
+		return 0.;
+	} else if (dt >= 1.) {
+		return delta;
+	}
+	const auto decay = std::exp(-7.5 * dt);
+	const auto oscillation = std::cos(10.5 * dt) + 0.714 * std::sin(10.5 * dt);
+	return delta * (1. - decay * oscillation);
+}
 
